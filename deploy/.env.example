# Agent token — pre-seeded or issued by the control-plane
AXYRA_AGENT_TOKEN=axyra_agent_secret_token_123

# JWT secret for the Axyra platform (control-plane). Must be at least 32 characters.
# The value below is public; replace it before exposing the service.
JWT_SECRET=axyra-jwt-super-secret-key-phase1

# Console logins. Choose your own; leave empty to have the control plane generate
# one and print it once in its startup logs. Passwords are only used when the
# users are first created.
AXYRA_ADMIN_PASSWORD=
AXYRA_OPERATOR_PASSWORD=
